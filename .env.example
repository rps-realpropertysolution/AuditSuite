# Copie este arquivo para .env e preencha com as chaves do projeto Supabase.
# O .env NÃO vai para o Git (ver .gitignore). Este .env.example VAI — nunca
# coloque valores reais aqui.
#
# Onde encontrar: Supabase Dashboard > Project Settings > API
#   - Project URL        -> VITE_SUPABASE_URL
#   - anon / publishable -> VITE_SUPABASE_ANON_KEY
#
# ATENÇÃO: use SEMPRE a chave pública (anon/publishable).
# A chave "service_role" ignora todas as regras de segurança do banco
# e nunca deve aparecer no frontend nem ser versionada.

VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_ANON_KEY="sua-chave-publica-aqui"

# ---------------------------------------------------------------------------
# LiveFacilities (RP Smart) — SÓ para o teste local (npm run lf:testar).
# Em produção estes valores ficam nos secrets do Supabase (Edge Function),
# nunca no frontend. Use um usuário só para a integração, com perfil de
# leitura. Nunca cole a senha no chat nem faça commit do .env.
# ---------------------------------------------------------------------------
LF_USUARIO=""
LF_SENHA=""
# LF_BASE_URL="https://rps.livefacilities.com.br/api"
